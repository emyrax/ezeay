{
  "name": "ezeay",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "start:server": "node scripts/free-port.mjs && tsx watch server/index.ts",
    "test": "npm run test:server && npm run test:tutor && npm run test:agent && npm run test:layout && npm run test:stats && npm run test:community && npm run test:lesson && npm run test:onboarding && npm run test:auth && npm run test:reels && npm run test:threads && npm run test:learning && npm run test:quiz && npm run test:media && npm run test:mascot && npm run test:profile && npm run test:voice",
    "test:profile": "tsx --test --test-force-exit lib/profile/validation.test.ts",
    "test:voice": "tsx --test --test-force-exit lib/voice/appendTranscript.test.ts",
    "test:server": "tsx --test --test-force-exit server/app.test.ts server/lessonScript.test.ts server/mathjax.test.ts server/pcmToWav.test.ts server/audio/deliveryUrl.test.ts server/profilePayload.test.ts",
    "test:tutor": "tsx --test --test-force-exit server/rag.test.ts server/tutor/tutor.test.ts server/tutor/routes.quiz.test.ts lib/tutor/prompt.test.ts lib/tutor/plan.test.ts",
    "test:agent": "tsx --test --test-force-exit server/agent/foundation.test.ts server/agent/planner.test.ts server/agent/tools.test.ts server/agent/run.test.ts server/agent/routes.test.ts",
    "test:layout": "tsx --test --test-force-exit lib/responsive.test.ts",
    "test:stats": "tsx --test --test-force-exit lib/statsLayout.test.ts lib/stats/activity.test.ts",
    "test:community": "tsx --test --test-force-exit lib/community/resourceComposer.test.ts",
    "test:lesson": "tsx --test --test-force-exit lib/lesson/player.test.ts lib/lesson/motion.test.ts",
    "test:onboarding": "tsx --test --test-force-exit lib/onboarding/steps.test.ts lib/onboarding/merge.test.ts lib/onboarding/signup.test.ts",
    "test:auth": "tsx --test --test-force-exit lib/auth/validation.test.ts lib/auth/errors.test.ts",
    "test:reels": "tsx --test --test-force-exit lib/reels/challenge.test.ts",
    "test:threads": "tsx --test --test-force-exit server/threadFeed.test.ts lib/threads/format.test.ts",
    "test:learning": "tsx --test --test-force-exit lib/quiz/grade.test.ts lib/focus/selectors.test.ts lib/lesson/visualLessonStatus.test.ts",
    "test:quiz": "tsx --test --test-force-exit lib/quiz/normalize.test.ts lib/providers/modelRegistry.test.ts",
    "test:media": "tsx --test --test-force-exit scripts/mascotNaming.test.ts",
    "test:mascot": "tsx --test --test-force-exit lib/mascot/actions.test.ts",
    "media:mascots": "tsx scripts/process-mascot-media.ts",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "deploy:web": "npx --yes vercel@latest --prod",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx db/seed.ts"
  },
  "dependencies": {
    "@clerk/expo": "^3.2.16",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@google/genai": "^2.10.0",
    "@neondatabase/serverless": "^1.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.16.2",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.2.5",
    "drizzle-orm": "0.44.5",
    "expo": "^57.0.0",
    "expo-ai-kit": "^0.18.1",
    "expo-apple-authentication": "~57.0.1",
    "expo-audio": "~57.0.4",
    "expo-auth-session": "~57.0.11",
    "expo-blur": "~57.0.3",
    "expo-calendar": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-picker": "~57.0.16",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.19",
    "expo-notifications": "~57.0.17",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.20",
    "expo-speech-recognition": "^57.1.0",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "supertest": "^7.3.1",
    "tsx": "^4.19.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
