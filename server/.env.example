# Copy to .env and fill in real values. Never commit .env.
PORT=3001

# Required
NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
GEMINI_API_KEY=your_gemini_api_key

# Optional AI provider keys. Server runs without them (Gemini only).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Comma-separated browser origins allowed via CORS (e.g. https://app.example.com).
# Empty in production = no cross-origin browser access.
CORS_ORIGINS=

# Comma-separated hostnames allowed as absolute file URLs for /api/study/process.
# Cloudinary hosts are always allowed.
STUDY_FETCH_ALLOWLIST=

# Requests per minute.
GLOBAL_RATE_LIMIT=300
STRICT_RATE_LIMIT=20