{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "dist",
    "rootDir": "..",
    "downlevelIteration": true,
    "baseUrl": "..",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": false
  },
  "include": [
    "index.ts",
    "../db/**/*.ts",
    "../types/**/*.ts",
    "../lib/gemini.ts",
    "../lib/providers/**/*.ts"
  ]
}
