{
  "expo": {
    "name": "Yuinx",
    "slug": "ezeay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ezeay",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ezeay.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#152A4D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.ezeay.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "themeColor": "#152A4D",
      "backgroundColor": "#152A4D"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": true,
            "default": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#152A4D",
          "dark": {
            "backgroundColor": "#152A4D"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Yuinx to scan pages of your notes into study bites.",
          "cameraPermission": "Allow Yuinx to photograph pages of notes to turn into study bites.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      "@clerk/expo",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Yuinx to record audio for voice notes.",
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Yuinx to listen while you record voice notes.",
          "speechRecognitionPermission": "Allow Yuinx to transcribe your voice notes in real time."
        }
      ],
      "expo-font",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "fr", "pt", "sw", "ar"]
          }
        }
      ],
      [
        "expo-ai-kit",
        {
          "llm": true
        }
      ],
      "expo-sharing",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Yuinx to add study sessions and reminders to your calendar.",
          "remindersPermission": "Allow Yuinx to add study reminders to your reminders."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Yuinx to use your current location to set your profile location and find universities near you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
