# Copy to .env and fill in real values. Never commit .env.

# Clerk publishable key (public, safe to embed). Required in production builds.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Upstream API origin. Production/dev builds must point here.
# In local dev it can be auto-detected from the Expo host.
EXPO_PUBLIC_API_URL=http://localhost:3001