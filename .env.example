# Copy to .env and fill in real values. Never commit .env.

# Clerk publishable key (public, safe to embed). Required in production builds.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Upstream API origin. Production/dev builds must point here.
# In local dev it can be auto-detected from the Expo host.
# Production: set to your deployed API, e.g. https://api.your-domain.com
EXPO_PUBLIC_API_URL=http://localhost:3001
# AI Tutor feature flag. Set to true to enable the legacy Tutor entry point.
EXPO_PUBLIC_TUTOR_ENABLED=false
# Agentic study platform flag. Set to true to enable the agent experience.
EXPO_PUBLIC_AGENT_ENABLED=false
# Keep the legacy Tutor available alongside the agent during migration.
EXPO_PUBLIC_LEGACY_TUTOR_ENABLED=false

# Agent tools (server-side). Leave disabled until keys are configured.
AGENT_TOOLS_ENABLED=false
AGENT_DAILY_TOOL_LIMIT=20
COMPOSIO_API_KEY=
E2B_API_KEY=

# Inngest (server-side). Use INNGEST_DEV=1 for local development.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1
